# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Build / dist
build/
dist/
*.egg-info/
*.egg

# Logs (run-time logs only — keep the `logs/` skeleton empty in the repo)
*.log
!logs/.gitkeep

# Per-run outputs (kept local; one folder per scan target)
outputs/
!outputs/.gitkeep

# SecLists / wordlists clone target — populated by `setup.py --wordlists`.
# Lives inside the repo by default; treated as build artifact.
# Only the cloned SecLists content is ignored — the parent `wordlists/`
# folder itself is tracked (via `.gitkeep`) so the layout is visible
# even before setup.py runs.
wordlists/SecLists/
wordlists/**/SecLists/

# Tool state
.nuclei-templates/
.kali-tools-state/

# Local config overrides
config.local.yml
*.local.yml
