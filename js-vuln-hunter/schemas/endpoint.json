{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Endpoint",
  "type": "object",
  "required": ["endpoint_id", "asset_id", "url_template"],
  "properties": {
    "endpoint_id": {"type": "string"},
    "asset_id": {"type": "string"},
    "method": {"type": "string"},
    "url_template": {"type": "string"},
    "kind": {"type": "string", "enum": ["rest", "graphql", "websocket"]},
    "dynamic": {"type": "boolean"},
    "parameters": {"type": "array", "items": {"type": "string"}},
    "auth_hint": {"type": ["string", "null"]},
    "interesting": {"type": "boolean"},
    "object_ids": {"type": "array", "items": {"type": "string"},
      "description": "Client-controlled object-identifier segments (BOLA lever)."},
    "sensitive_op": {"type": "boolean",
      "description": "Mutating verb or privileged/sensitive path (BFLA lever)."},
    "location": {"type": ["object", "null"]}
  }
}
